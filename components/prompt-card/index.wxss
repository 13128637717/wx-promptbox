.item {
  position: relative;
  display: flex;
  margin: 0 0 20rpx;
  padding: 28rpx;
}

.icon {
  width: 84rpx;
  height: 84rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}

.body {
  flex: 1;
  min-width: 0;
}

.body.has-more {
  padding-right: 40rpx;
}

.more {
  position: absolute;
  top: 0;
  right: 8rpx;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 48rpx;
}

.pip {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #9ca3af;
}

.pip + .pip {
  margin-top: 5rpx;
}

.title-row {
  display: flex;
  align-items: center;
}

.title {
  font-size: 30rpx;
  font-weight: 650;
  color: #1f2937;
}

.mine {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
}

.desc {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.heat,
.time {
  margin-left: 16rpx;
  color: #9ca3af;
  font-size: 22rpx;
}
