.empty {
  padding: 120rpx 48rpx;
  text-align: center;
}

.mark {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 120rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 650;
  color: #1f2937;
}

.desc {
  margin-top: 12rpx;
  color: #9ca3af;
  font-size: 24rpx;
}
