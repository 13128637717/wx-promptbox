<view class="page history">
  <view class="bar">
    <scroll-view class="chip-row chips" scroll-x>
      <text class="chip {{categoryId === '' ? 'on' : ''}}" data-id="" bindtap="onCategory">全部</text>
      <text
        wx:for="{{categories}}"
        wx:key="id"
        class="chip {{categoryId === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategory"
      >{{item.name}}</text>
    </scroll-view>
    <text class="clear" bindtap="onClear">清空</text>
  </view>

  <view class="row" wx:for="{{list}}" wx:key="recordId">
    <prompt-card prompt="{{item.card}}" show-heat="{{false}}" time-text="{{item.timeText}}" data-record="{{item.recordId}}" bind:select="onSelect" />
    <view class="ops">
      <text data-record="{{item.recordId}}" bindtap="onCopy">再次复制</text>
      <text class="danger" data-record="{{item.recordId}}" bindtap="onDelete">删除</text>
    </view>
  </view>
  <empty-state wx:if="{{!list.length}}" title="还没有使用记录" desc="复制提示词后，最近 50 条会留在这里" />
</view>
