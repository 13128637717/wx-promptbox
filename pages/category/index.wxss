.layout {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  overflow: hidden;
  background: #f7f8fa;
}

.side {
  width: 180rpx;
  height: 100%;
  min-height: 0;
  background: #ffffff;
}

.side-item {
  padding: 28rpx 12rpx;
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
}

.side-item.on {
  background: #eff6ff;
  color: #2563eb;
  font-weight: 650;
}

.main {
  display: flex;
  flex: 1;
  flex-direction: column;
  height: 100%;
  min-width: 0;
  min-height: 0;
}

.toolbar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 8rpx;
}

.count {
  color: #9ca3af;
  font-size: 22rpx;
}

.sorts text {
  margin-left: 20rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.sorts .on {
  color: #2563eb;
  font-weight: 650;
}

.tags {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 8rpx 24rpx 12rpx;
}

.feed {
  flex: 1;
  height: 0;
  min-height: 0;
}

.side-pad {
  height: 24rpx;
}

.list {
  padding: 8rpx 20rpx 48rpx;
}

.sheet {
  padding: 8rpx 12rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.04);
}
