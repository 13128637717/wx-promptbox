<view class="page" wx:if="{{missing}}">
  <empty-state title="没有找到这个分类" />
</view>
<view class="page" wx:else>
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="hero-bar">
      <view class="nav-back light" bindtap="onBack">‹</view>
      <view class="badge">
        <mark name="{{category.icon || 'grid'}}" ink="#ffffff" />
      </view>
      <view class="hero-copy">
        <view class="hero-title">{{category.name}}</view>
        <view class="hero-desc">{{category.description}}</view>
      </view>
    </view>
  </view>
  <view class="panel">
    <view class="toolbar">
      <text class="count">共 {{list.length}} 条</text>
      <view class="sorts">
        <text class="{{sort === 'heat' ? 'on' : ''}}" data-sort="heat" bindtap="onSort">热度</text>
        <text class="{{sort === 'latest' ? 'on' : ''}}" data-sort="latest" bindtap="onSort">最新</text>
      </view>
    </view>
    <scroll-view class="chip-row tags" scroll-x wx:if="{{tags.length}}">
      <text class="chip {{tag === '' ? 'on' : ''}}" data-tag="" bindtap="onTag">全部</text>
      <text wx:for="{{tags}}" wx:key="*this" class="chip {{tag === item ? 'on' : ''}}" data-tag="{{item}}" bindtap="onTag">{{item}}</text>
    </scroll-view>
    <view class="list">
      <prompt-card wx:for="{{list}}" wx:key="id" prompt="{{item}}" bind:select="onSelect" />
      <empty-state wx:if="{{!list.length}}" title="这个分类还没有提示词" />
    </view>
  </view>
</view>
