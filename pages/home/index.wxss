.home {
  padding: 16rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #e7f1ff 0%, #f4f7fb 280rpx, #f7f8fa 420rpx);
}

.title {
  margin: 16rpx 8rpx 24rpx;
  padding-right: 180rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.search {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #9ca3af;
  font-size: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.06);
}

.search-ico {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  overflow: visible;
}

.banner {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 32rpx 24rpx 32rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(120deg, #eef6ff 0%, #d7e9ff 55%, #c9e0ff 100%);
}

.banner-copy {
  flex: 1;
  min-width: 0;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.banner-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5d7190;
}

.banner-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 650;
}

.banner-art {
  width: 148rpx;
  height: 148rpx;
  margin-left: 12rpx;
  border-radius: 36rpx;
  background: linear-gradient(160deg, #69b0ff, #2f6fed);
  box-shadow: 0 16rpx 32rpx rgba(47, 111, 237, 0.22);
  flex-shrink: 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  padding: 16rpx 0 12rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.04);
}

.cell {
  width: 25%;
  padding: 16rpx 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #4b5563;
}

.tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 12rpx;
  border-radius: 26rpx;
}

.tile.all {
  background: #e8f1ff;
}
