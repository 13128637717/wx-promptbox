.topbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  background: #e7f1ff;
}

.title {
  height: 44px;
  padding: 0 180rpx 0 40rpx;
  line-height: 44px;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home {
  padding-right: 32rpx;
  padding-bottom: 48rpx;
  padding-left: 32rpx;
  background: linear-gradient(180deg, #e7f1ff 0%, #f4f7fb 280rpx, #f7f8fa 420rpx);
}

.search {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-top: 16rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #9ca3af;
  font-size: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.06);
}

.search-ico {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  overflow: visible;
}

.banner {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 32rpx 24rpx 32rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(120deg, #1d4ed8 0%, #3b82f6 100%);
}

.banner-copy {
  flex: 1;
  min-width: 0;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.banner-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 650;
}

.banner-art {
  width: 148rpx;
  height: 148rpx;
  margin-left: 12rpx;
  border-radius: 36rpx;
  background: linear-gradient(160deg, #8ec5ff, #4c8df5);
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.16);
  flex-shrink: 0;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  padding: 16rpx 0 12rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.04);
}

.cell {
  width: 25%;
  padding: 16rpx 0 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #374151;
}

.cell-on {
  opacity: 0.72;
}

.tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 12rpx;
  border-radius: 28rpx;
}

.tile.all {
  background: #e8f1ff;
}

.hot {
  margin-top: 28rpx;
  padding: 28rpx 12rpx 8rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.04);
}

.hot-title {
  margin: 0 16rpx 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}
