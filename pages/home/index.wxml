<view class="topbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="title">AI 提示词工具箱</view>
</view>
<view class="page home" style="padding-top: {{navBarHeight}}px;">
  <view class="search" bindtap="onSearch">
    <view class="search-ico"><mark name="search" ink="#9CA3AF" /></view>
    <text>搜索提示词、场景或功能...</text>
  </view>

  <view class="banner">
    <view class="banner-copy">
      <view class="banner-title">从灵感到落地</view>
      <view class="banner-sub">精选提示词，助你高效使用 AI</view>
      <view class="banner-btn" bindtap="onFeatured">立即体验 →</view>
    </view>
    <view class="banner-art">
      <mark name="cube" />
    </view>
  </view>

  <view class="grid">
    <view
      class="cell"
      hover-class="cell-on"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCategory"
    >
      <view class="tile" style="background: {{item.tint}};">
        <mark name="{{item.icon}}" ink="{{item.color}}" />
      </view>
      <text>{{item.name}}</text>
    </view>
    <view class="cell" hover-class="cell-on" data-id="all" bindtap="onCategory">
      <view class="tile all">
        <mark name="grid" ink="#3B82F6" />
      </view>
      <text>全部分类</text>
    </view>
  </view>

  <view class="hot">
    <view class="hot-title">热门推荐</view>
    <prompt-card
      wx:for="{{hot}}"
      wx:key="id"
      prompt="{{item}}"
      brief="{{true}}"
      plain="{{true}}"
      last="{{index === hot.length - 1}}"
      bind:select="onSelect"
    />
  </view>
</view>
