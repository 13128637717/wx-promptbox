.about {
  padding: 48rpx 32rpx;
  text-align: center;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  margin: 12rpx auto 0;
  border-radius: 40rpx;
  background: linear-gradient(160deg, #60a5fa, #2563eb);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 140rpx;
}

.name {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.ver {
  margin-top: 8rpx;
  color: #9ca3af;
}

.block {
  margin-top: 24rpx;
  padding: 28rpx;
  text-align: left;
}

.title {
  font-weight: 700;
}

.text {
  margin-top: 12rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.7;
}
