.create {
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
  background: linear-gradient(180deg, #e8f1ff 0%, #f7f8fa 280rpx);
}

.top {
  height: 88rpx;
  display: flex;
  align-items: center;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  color: #6b7280;
}

.box {
  margin-top: 32rpx;
  padding: 28rpx;
}

.box-label {
  color: #9ca3af;
  font-size: 24rpx;
}

.demand {
  width: 100%;
  height: 220rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.holder {
  color: #9ca3af;
}

.block-title {
  margin: 36rpx 8rpx 16rpx;
  font-weight: 650;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.tpl {
  margin: 0 16rpx 16rpx 0;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 26rpx;
}

.tpl.on {
  background: #2563eb;
  color: #ffffff;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: rgba(247, 248, 250, 0.96);
}
