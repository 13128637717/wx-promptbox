.result {
  min-height: 100vh;
  padding: 0 32rpx 48rpx;
  background: linear-gradient(180deg, #ecfdf5 0%, #f7f8fa 280rpx);
}

.top {
  height: 88rpx;
  display: flex;
  align-items: center;
}

.check {
  width: 120rpx;
  height: 120rpx;
  margin: 12rpx auto 0;
  border-radius: 50%;
  background: #16a34a;
  color: #ffffff;
  font-size: 64rpx;
  text-align: center;
  line-height: 120rpx;
}

.ok {
  margin-top: 20rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  text-align: center;
  color: #6b7280;
}

.sheet {
  margin-top: 32rpx;
  padding: 28rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
}

.icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
}

.pill {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.body {
  width: 100%;
  height: 420rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.btn-primary {
  margin-top: 32rpx;
}
