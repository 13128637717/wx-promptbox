<view class="page create" style="padding-top: {{statusBarHeight}}px;">
  <view class="top">
    <view class="nav-back" bindtap="onBack">‹</view>
  </view>
  <view class="title">创建提示词</view>
  <view class="sub">告诉我你想要什么，我来帮你生成</view>

  <view class="box card">
    <view class="box-label">输入你的需求，例如：</view>
    <textarea
      class="demand"
      value="{{demand}}"
      maxlength="-1"
      placeholder="帮我写一篇关于 AI 趋势的公众号文章，要求 1200 字左右"
      placeholder-class="holder"
      bindinput="onDemand"
    />
  </view>

  <view class="block-title">推荐模板</view>
  <view class="chips">
    <view
      wx:for="{{templates}}"
      wx:key="id"
      class="tpl {{selectedId === item.id ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onPick"
    >{{item.chipLabel}}</view>
  </view>

  <view class="footer safe-bottom">
    <view class="btn-primary" bindtap="onGenerate">生成提示词</view>
  </view>
</view>
