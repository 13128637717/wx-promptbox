.edit {
  padding: 24rpx 32rpx 64rpx;
}

.field {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  font-weight: 650;
}

.input {
  height: 72rpx;
  font-size: 28rpx;
}

.picker {
  height: 72rpx;
  line-height: 72rpx;
  color: #1f2937;
}

.content {
  width: 100%;
  height: 320rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.var-head {
  display: flex;
  justify-content: space-between;
  margin: 12rpx 8rpx 16rpx;
  font-weight: 650;
}

.link {
  color: #2563eb;
  font-weight: 500;
}

.req-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.req-row switch {
  margin-left: 16rpx;
}

.req-row .link {
  margin-left: auto;
}

.btn-primary {
  margin-top: 12rpx;
}

.danger {
  color: #dc2626;
}
